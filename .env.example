# goauth — environment
#
# This module reads no environment variable: it is a library, configured through
# goauth.Options passed to goauth.NewSettings by the application embedding it.
# What follows is the convention the applications using it are expected to follow,
# and the mapping to honour. The module names each variable as a constant, so a host
# reads them without hardcoding the strings:
#
#   AUTH_PROVIDER    → goauth.ProviderEnv    → Options.ProviderName
#   AUTH_ISSUER      → goauth.IssuerEnv      → Options.IssuerURL
#   AUTH_AUDIENCE    → goauth.AudienceEnv    → Options.Audience
#   AUTH_ADMIN_ROLE  → goauth.AdminRoleEnv   → Options.AdminRole
#   AUTH_GUEST_ROLE  → goauth.GuestRoleEnv   → Options.GuestRole
#   AUTH_DEMO        → goauth.DemoEnv        → Options.Demo
#
#   AUTH_REQUIRE_INTROSPECTION → goauth.RequireIntrospectionEnv
#
# See SETUP.md for the provider side.

# Kind of identity provider, one of: zitadel, pocketid.
# It is the only setting with no default: it decides which claim the roles are read
# from, and guessing it would read them from a claim nobody fills, denying everyone.
AUTH_PROVIDER=

# Instance URL of the OIDC identity provider, no trailing slash.
# It must serve /.well-known/openid-configuration: discovery happens at startup,
# and the application fails to start when the provider is unreachable.
AUTH_ISSUER=https://auth.example.com

# Client Id of this application, checked against the token audience claim.
# It is what isolates applications sharing an issuer: a token minted for one is
# rejected by the others.
AUTH_AUDIENCE=

# Names the provider gives to the roles this application grants, as they are spelled
# in its console. Left empty, they default to "admin" and "guest".
AUTH_ADMIN_ROLE=
AUTH_GUEST_ROLE=

# Authorize every visitor as admin, bypassing token verification entirely.
# LOCAL DEVELOPMENT ONLY. It must never be true in production.
#
# Setting it is not enough: the binary must also be built with `-tags authdemo`, or
# startup fails. And it refuses to run beside AUTH_PROVIDER, AUTH_ISSUER or
# AUTH_AUDIENCE, so a stray value here cannot quietly open a configured deployment.
AUTH_DEMO=false

# Refuse to start against an issuer advertising no introspection endpoint,
# rather than running without one. Without it the issuer is never asked whether
# a token is still one it stands behind, so a disabled account, a changed
# password or an ended session all keep working until the token expires — which
# for a session held by a refresh token is never. Check your provider first:
#
#   curl -s "$AUTH_ISSUER/.well-known/openid-configuration" \
#     | jq -r .introspection_endpoint
#
# Zitadel and PocketID both advertise one. It refuses to run beside AUTH_DEMO,
# which verifies no token at all.
AUTH_REQUIRE_INTROSPECTION=true

# --- Server driven login (optional) ---------------------------------------
#
# Set these to have the application run the OIDC flow itself, so the frontend
# never handles a token. They map to goauth.BrowserOptions, which has no
# environment convention of its own: the secret below belongs in a secret
# store rather than in a .env file.
#
# Client secret of this application at the provider. Leave empty for a public
# client, where PKCE alone proves the code exchange.
AUTH_CLIENT_SECRET=
#
# Absolute URL the provider sends the browser back to. It must be registered
# there, and must resolve to /auth/callback on this application.
AUTH_REDIRECT_URL=https://app.example.com/auth/callback
#
# Seals the session cookie. At least 32 bytes of randomness:
#   openssl rand -base64 48
# Losing it signs everyone out; leaking it lets its holder mint sessions.
AUTH_COOKIE_SECRET=
#
# Secrets that no longer seal but still open what they sealed, so that
# replacing the one above does not sign every visitor out at once. Pass them
# to goauth.WithRetiredSecrets; there is no environment convention for a list,
# so how they are read is the host's business. Drop one once the sessions it
# sealed are gone: kept for ever, a leaked secret stays usable for ever.
AUTH_RETIRED_COOKIE_SECRETS=
